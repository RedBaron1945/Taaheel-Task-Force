{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated user, supervisor, attendance officer, or student in the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["supervisor", "attendance", "student"] },
        "avatar": { "type": "string", "maxLength": 60 },
        "mahadId": { "type": "string", "maxLength": 80 },
        "mahadName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Educational or Quranic assignment assigned to students.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "sourceType": { "type": "string", "maxLength": 50 },
        "sourceUrl": { "type": "string", "maxLength": 500 },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "points": { "type": "number" },
        "active": { "type": "boolean" },
        "subtasks": { "type": "array" }
      },
      "required": ["id", "title", "points"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Session attendance log for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["present", "excused", "absent"] },
        "recordedAt": { "type": "string" },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "studentId", "date", "status"]
    },
    "ProgressRecord": {
      "title": "ProgressRecord",
      "description": "Subtask completion status and submission by student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "subtaskId": { "type": "string", "maxLength": 128 },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "studentId", "assignmentId", "subtaskId"]
    },
    "Mahad": {
      "title": "Mahad",
      "description": "A learning center (Mahad) in the qualification phase.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 120 },
        "track": { "type": "string", "maxLength": 50 },
        "neighborhood": { "type": "string", "maxLength": 80 },
        "color": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "name", "track"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profiles for supervisors, attendance officers, and students."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Assignments and subtasks for students."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Sunday and Tuesday attendance roll call entries."
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "#/entities/ProgressRecord" },
      "description": "Subtask progress tracking for students."
    },
    "/mahaden/{mahadId}": {
      "schema": { "$ref": "#/entities/Mahad" },
      "description": "The 7 active qualification centers."
    }
  }
}
