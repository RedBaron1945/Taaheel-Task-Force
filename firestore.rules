rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSupervisor() {
      return isAuthenticated() && (
        request.auth.uid == 'O83e55HQuyajVh3Ji4FJltobyg63' ||
        request.auth.token.email == 'admin@taaheel.sa' ||
        request.auth.token.email == 'supervisor@taaheeltaskforce.com' ||
        request.auth.token.email == 'bbrys005@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor')
      );
    }

    function isAttendanceOfficer() {
      return isAuthenticated() && (
        request.auth.uid == 'TnCoR9ZTSibHTvIt15VPeQHfGFy1' ||
        request.auth.token.email == 'attendance@taaheeltaskforce.com' ||
        request.auth.token.email == 'bbrys005@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'attendance') ||
        isSupervisor()
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSupervisor();
    }

    // 2. Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Mahaden collection
    match /mahaden/{mahadId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 4. Attendance collection (Roll call records)
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 5. Progress collection (Student subtask tracking)
    match /progress/{progressId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 6. Settings collection
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Test connection doc
    match /test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Deny anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
