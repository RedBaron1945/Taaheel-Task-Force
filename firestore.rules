rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // دوال التحقق من الهوية والأدوار الإدارية (Dynamic UID & RBAC)
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // المشرف العام (مبني على الـ UID الخاص بالمشرف أو دوره المسجل في النظام)
    function isSupervisor() {
      return isAuthenticated() && (
        request.auth.uid == 'O83e55HQuyajVh3Ji4FJltobyg63' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor'
        )
      );
    }

    // مسؤول التحضير (مبني على الـ UID الخاص بمسؤول التحضير أو دوره والمشرف)
    function isAttendanceOfficer() {
      return isAuthenticated() && (
        request.auth.uid == 'TnCoR9ZTSibHTvIt15VPeQHfGFy1' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['attendance', 'supervisor']
        ) ||
        isSupervisor()
      );
    }

    // التحقق التلقائي من أن الـ UID يخص طالباً مسجلاً ومعتمداً في قاعدة البيانات
    function isRegisteredStudent() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }


    // ============================================
    // 1. دليل المستخدمين والطلاب (Users)
    // ============================================
    match /users/{userId} {
      // السماح بالقراءة لتشغيل التحقق وتسجيل الدخول ولوحة الصدارة
      allow read: if true;

      // المشرف فقط ينشئ ويحذف المستخدمين
      allow create, delete: if isSupervisor();

      // التحديث متاح للمشرف، أو لصاحب الحساب لنفسه فقط
      allow update: if isSupervisor() || (isAuthenticated() && request.auth.uid == userId);
    }


    // ============================================
    // 2. التكليفات والمهام (Assignments)
    // ============================================
    match /assignments/{assignmentId} {
      // القراءة متاحة لعرض التكليفات للطلاب
      allow read: if true;

      // الإضافة والتعديل والحذف للمشرف فقط
      allow write: if isSupervisor();
    }


    // ============================================
    // 3. المحاضن والمراكز (Mahaden)
    // ============================================
    match /mahaden/{mahadId} {
      // القراءة متاحة للجميع لعرض تصنيفات المحاضن
      allow read: if true;

      // الإدارة للمشرف فقط
      allow write: if isSupervisor();
    }


    // ============================================
    // 4. سجلات التحضير (Attendance)
    // ============================================
    match /attendance/{recordId} {
      // القراءة متاحة لعرض نسب الحضور والإحصائيات
      allow read: if true;

      // تسجيل وتعديل وإلغاء التحضير لمسؤول التحضير والمشرف فقط
      allow write: if isAttendanceOfficer();
    }


    // ============================================
    // 5. إنجاز الطلاب للمهام (Progress)
    // ============================================
    match /progress/{progressId} {
      // القراءة متاحة لحساب النقاط ولوحة الأوائل
      allow read: if true;

      // المشرف ينشئ أي سجل، والطالب المعتمد يسجل إنجاز نفسه فقط
      allow create: if isSupervisor() || (
        isAuthenticated() && 
        request.resource.data.studentId == request.auth.uid &&
        isRegisteredStudent()
      );

      // التعديل: المشرف، أو الطالب لنفس سجله دون إمكانية تغيير معرف الطالب
      allow update: if isSupervisor() || (
        isAuthenticated() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid
      );

      // الحذف للمشرف فقط
      allow delete: if isSupervisor();
    }


    // ============================================
    // 6. الإعدادات العامة (Settings)
    // ============================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSupervisor();
    }


    // ============================================
    // 7. وثيقة اختبار الاتصال (Test)
    // ============================================
    match /test/{docId} {
      allow read, write: if true;
    }


    // ============================================
    // حظر أي مسار آخر غير مصرح به
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
